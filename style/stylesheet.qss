QWidget { color: #26364E; font-size: 10pt; }
QMainWindow { background: #F5F8FC; }
#appFrame { background: #F5F8FC; border: 1px solid #BCCADD; }
#appTitleBar { background: #F5F8FC; }
QLabel, QStackedWidget { background: transparent; }
#appTitleText { font-weight: 600; }
QPushButton { background: #FFFFFF; border: 1px solid #D4DEEA; border-radius: 6px; padding: 5px 10px; min-height: 24px; qproperty-iconSize: 18px 18px; }
QPushButton:hover { background: #E4F0FF; border-color: #9ABDE8; }
QPushButton:pressed { background: #CFDFF4; }
QPushButton:focus { border: 1px solid #1478E8; }
QPushButton:disabled { color: #8895A7; background: #EDF1F7; border-color: #E5EBF4; }
#windowMinButton, #windowCloseButton { min-width: 44px; max-width: 44px; min-height: 36px; max-height: 36px; padding: 0; border: none; background: transparent; qproperty-iconSize: 24px 24px; }
#windowMinButton:hover { background: #E4F0FF; }
#windowCloseButton:hover { background: #F4DDDA; color: #A23931; }
#manageButton, #addMusicButton { min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px; padding: 0; background: transparent; border-color: transparent; qproperty-iconSize: 20px 20px; }
#manageButton:hover, #addMusicButton:hover { background: #E4F0FF; }
#manageButton:focus, #addMusicButton:focus { border-color: #1478E8; }
#trackTitleLabel { font-size: 14pt; font-weight: 600; color: #26364E; }
#timeLabel { color: #64758D; font-size: 10pt; }
#coverArtLabel { background: #E5EBF4; border: none; }
#controlsContainer { background: transparent; }
#controlsContainer QPushButton { min-width: 30px; max-width: 30px; min-height: 34px; max-height: 34px; padding: 0; border-color: transparent; background: transparent; }
#controlsContainer QPushButton:hover { background: #E4F0FF; }
#controlsContainer QPushButton:focus { border-color: #1478E8; }
#controlsContainer #playPauseButton { min-width: 44px; max-width: 44px; min-height: 44px; max-height: 44px; background: #1478E8; border-radius: 22px; qproperty-iconSize: 24px 24px; }
#controlsContainer #playPauseButton:hover { background: #0966CD; }
#controlsContainer #playPauseButton:pressed { background: #0959AC; }
#controlsContainer #modeButton[active="true"] { background: #E4F0FF; }
#volumeMeter { qproperty-barColor: #83B6EE; }
QSlider#progressSlider { background: transparent; }
QSlider#progressSlider::groove:horizontal { background: #D4DEEA; height: 4px; border-radius: 2px; }
QSlider#progressSlider::sub-page:horizontal { background: #1478E8; border-radius: 2px; }
QSlider#progressSlider::handle:horizontal { background: #1478E8; border: 2px solid #FFFFFF; width: 12px; height: 12px; margin: -5px 0; border-radius: 7px; }
QSlider#progressSlider:focus::handle:horizontal { border-color: #9ABDE8; }
QTreeWidget, QListWidget { background: #F5F8FC; alternate-background-color: #F5F8FC; border: none; border-radius: 0; padding: 4px; selection-background-color: #DCEAFF; selection-color: #26364E; }
QTreeWidget::item, QListWidget::item { min-height: 28px; padding: 3px 6px; }
QTreeWidget::item:hover, QListWidget::item:hover { background: #ECF3FC; }
QTreeWidget::item:selected, QListWidget::item:selected { background: #DCEAFF; color: #26364E; }
QListWidget::item:focus { border: 1px solid #1478E8; }
QTreeWidget::branch { background: transparent; }
#managementPanel { background: transparent; border: none; }
#managementPanel QLabel { font-weight: 600; }
#managementActionPanel { background: transparent; }
#applyButton { background: #1478E8; color: #FFFFFF; }
#applyButton:hover { background: #0966CD; }
#removeButton { color: #A23931; }
#lyricsView { background: transparent; }
QToolTip, QMenu { color: #26364E; background: #FFFFFF; border: 1px solid #BCCADD; padding: 4px; }
QMenu::item { padding: 7px 20px; }
QMenu::item:selected { background: #DCEAFF; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #BAC8DB; min-height: 24px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #8DA5C2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

#removeButton:disabled { color: #8895A7; }
QLineEdit { background: #FFFFFF; color: #26364E; border: 1px solid #BCCADD; border-radius: 4px; padding: 6px; }
QLineEdit:focus { border-color: #1478E8; }

#durationLabel, #artistLabel { color: #64758D; }

#coverArtLabel { border-radius: 10px; }
#albumLabel { color: #64758D; font-size: 9pt; }
#playerView[compact="false"] #trackTitleLabel { font-size: 18pt; }
#playerView[compact="false"] #artistLabel { font-size: 12pt; }
#playerView[compact="false"] #albumLabel { font-size: 10pt; }
#playerView[compact="false"] #controlsContainer #playPauseButton { min-width: 54px; max-width: 54px; min-height: 54px; max-height: 54px; border-radius: 27px; qproperty-iconSize: 28px 28px; }
#playerView[compact="false"] #controlsContainer QPushButton { qproperty-iconSize: 22px 22px; }
#songTreeWidget { padding: 0; }
#songTreeWidget::item { padding: 0; border: none; }
#songTreeWidget::item:focus { border: none; }

#songTreeWidget::branch:has-children:closed { image: url(:/icons/chevron-right.svg); }
#songTreeWidget::branch:has-children:open { image: url(:/icons/chevron-down.svg); }

#manageButton:pressed, #addMusicButton:pressed { background: #CFDFF4; }
#manageButton:disabled, #addMusicButton:disabled { background: #EDF1F7; }
#libraryTitle { color: #1478E8; font-weight: 600; }
#lyricsPanel { background: #EDF4FC; border-radius: 8px; }
#lyricsToggle { min-height: 20px; padding: 0 4px; border: none; background: transparent; color: #64758D; text-align: right; }
#lyricsToggle:hover { color: #1478E8; }
#lyricsToggle:focus { border: 1px solid #9ABDE8; }
