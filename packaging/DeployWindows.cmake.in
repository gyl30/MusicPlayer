set(deploy_dir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
if(CMAKE_INSTALL_CONFIG_NAME STREQUAL "Debug")
    set(qt_config --debug)
else()
    set(qt_config --release)
endif()
execute_process(COMMAND "@WINDEPLOYQT_EXECUTABLE@" ${qt_config} --no-compiler-runtime --include-plugins qsqlite "${deploy_dir}/MusicPlayer.exe"
                RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "windeployqt 失败：${result}")
endif()

if(NOT DEFINED ENV{VCToolsRedistDir})
    message(FATAL_ERROR "VCToolsRedistDir is not set; use a Visual Studio developer environment")
endif()
file(GLOB runtime_directories LIST_DIRECTORIES true "$ENV{VCToolsRedistDir}/x64/Microsoft.VC*.CRT")
if(NOT runtime_directories)
    message(FATAL_ERROR "MSVC x64 runtime files not found in $ENV{VCToolsRedistDir}")
endif()
list(GET runtime_directories 0 runtime_directory)
foreach(runtime_file IN ITEMS msvcp140.dll vcruntime140.dll vcruntime140_1.dll)
    if(NOT EXISTS "${runtime_directory}/${runtime_file}")
        message(FATAL_ERROR "MSVC runtime missing: ${runtime_directory}/${runtime_file}")
    endif()
endforeach()
file(GLOB runtime_files "${runtime_directory}/*.dll" "${runtime_directory}/*.manifest")
file(COPY ${runtime_files} DESTINATION "${deploy_dir}")
