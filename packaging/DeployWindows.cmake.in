set(deploy_dir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
if(CMAKE_INSTALL_CONFIG_NAME STREQUAL "Debug")
    set(qt_config --debug)
else()
    set(qt_config --release)
endif()
execute_process(COMMAND "@WINDEPLOYQT_EXECUTABLE@" ${qt_config} --compiler-runtime "${deploy_dir}/MusicPlayer.exe"
                RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "windeployqt 失败：${result}")
endif()
